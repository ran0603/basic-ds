{
  "name": "basic-ds",
  "version": "1.1.0",
  "description": "A lightweight, Sass-based CSS design system with utility classes and reusable UI components.",
  "type": "module",
  "style": "./css/basic-ds.css",
  "sass": "./sass/basic-ds.scss",
  "exports": {
    ".": {
      "sass": "./sass/basic-ds.scss",
      "style": "./css/basic-ds.css",
      "default": "./css/basic-ds.css"
    },
    "./css": "./css/basic-ds.css",
    "./css/*": "./css/*",
    "./sass": "./sass/basic-ds.scss",
    "./sass/*": "./sass/*",
    "./package.json": "./package.json"
  },
  "files": [
    "css",
    "sass",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:sass && npm run build:prefix && npm run build:minify",
    "build:clean": "rimraf css",
    "build:sass": "sass sass/basic-ds.scss css/basic-ds.css --style expanded --source-map",
    "build:prefix": "postcss css/basic-ds.css --use autoprefixer --map false --output css/basic-ds.css",
    "build:minify": "cleancss -o css/basic-ds.min.css css/basic-ds.css",
    "watch": "sass --watch sass/basic-ds.scss css/basic-ds.css --style expanded --source-map",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razanazuddin/basic-ds.git"
  },
  "keywords": [
    "css",
    "sass",
    "scss",
    "design-system",
    "design-tokens",
    "utility-css",
    "ui-components"
  ],
  "author": "Razan Azuddin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/razanazuddin/basic-ds/issues"
  },
  "homepage": "https://github.com/razanazuddin/basic-ds#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "clean-css-cli": "^5.6.3",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.83.0"
  }
}